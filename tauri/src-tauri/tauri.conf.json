{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ColimaBar",
  "version": "1.11.0",
  "identifier": "io.github.damiengdn.colimabar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ColimaBar",
        "width": 1180,
        "height": 740,
        "minWidth": 780,
        "minHeight": 500,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Colima & Docker from your system tray",
    "longDescription": "ColimaBar manages Colima or Docker from the system tray: start/stop the engine, watch containers live, browse Compose projects, images, volumes and networks.",
    "copyright": "© 2026 Damien Guesdon",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
